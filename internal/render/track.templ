package render

// Track è la pagina di un brano: in alto l'hero con la copertina dell'album e
// l'anagrafica (band, album, anno, lingue disponibili), poi l'originale a
// sinistra e la traduzione a destra.
//
// Le lingue del brano sono tutte in pagina e il menu di ogni lato sceglie quella
// da leggere (assets/js/lyrica.js); senza JS restano visibili tutte. Il nome del
// cantante compare sopra la strofa solo se il contenuto lo dichiara (brani
// multi-voce).
templ Track(v TrackView) {
	@Layout(v.Page) {
		@breadcrumb(v.Page.T("a11y.breadcrumb"), v.Crumbs)
		@trackHero(v)
		<div class="track-blocks">
			@textSide(v.Page, "original", v.Page.T("track.original"), v.Page.T("track.choose_original"), v.Originals)
			if len(v.Translations) == 0 {
				<section class="track-side">
					<h2 class="side-label">{ v.Page.T("track.translation") }</h2>
					<p class="empty-state">{ v.Page.T("track.no_translation") }</p>
				</section>
			} else {
				@textSide(v.Page, "translation", v.Page.T("track.translation"), v.Page.T("track.choose_translation"), v.Translations)
			}
		</div>
	}
}

// trackHero mette la copertina dell'album a sinistra e l'anagrafica a destra;
// quando la copertina non c'è l'anagrafica prende tutta la larghezza. È la
// stessa resa della pagina album.
templ trackHero(v TrackView) {
	if v.ShowCover {
		<div class="track-hero row">
			<figure class="album-cover col-12 col-md-4">
				<img src={ v.CoverURL } alt={ v.CoverAlt } width="600" height="600" loading="lazy"/>
			</figure>
			<div class="col-12 col-md-8">
				@trackFacts(v)
			</div>
		</div>
	} else {
		<div class="track-hero">
			@trackFacts(v)
		</div>
	}
}

// trackFacts è il titolo del brano con la sua anagrafica: band, album, anno e
// lingue disponibili con la bandiera, più data di aggiunta e voci quando
// servono.
templ trackFacts(v TrackView) {
	<h1 class="page-title">{ v.Title }</h1>
	<dl class="album-facts">
		<dt>{ v.Page.T("album.band") }</dt>
		<dd><a href={ v.BandURL }>{ v.BandName }</a></dd>
		<dt>{ v.Page.T("track.album") }</dt>
		<dd><a href={ v.AlbumURL }>{ v.AlbumTitle }</a></dd>
		if v.YearText != "" {
			<dt>{ v.Page.T("album.year") }</dt>
			<dd>{ v.YearText }</dd>
		}
		if v.LangsText != "" {
			<dt>{ v.Page.T("track.langs") }</dt>
			<dd>{ v.LangsText }</dd>
		}
	</dl>
	<p class="track-meta">
		if v.DateText != "" {
			<span class="track-date">{ v.Page.T("track.added") }: { v.DateText }</span>
		}
		if v.SingersText != "" {
			<span class="track-singers">{ v.Page.T("track.singers") }: { v.SingersText }</span>
		}
	</p>
}

// textSide stampa un lato del testo: l'intestazione del lato (nome + lingua) e
// un blocco per ogni lingua disponibile.
//
// L'intestazione c'è **sempre su entrambi i lati**: è lei a tenere allineate le
// due colonne, e la lingua di un lato si mostra in due modi — un **menu** quando
// c'è più di una lingua da scegliere, un'**etichetta fissa** quando la lingua è
// una sola (D95). L'originale ha quasi sempre una lingua sola: un menu lì non
// servirebbe a niente. Il menu e l'etichetta hanno la stessa altezza
// (assets/css/lyrica.css), quindi le due intestazioni restano pari.
//
// Tutte le lingue restano nel DOM e il menu commuta quella visibile; senza JS la
// pagina mostra i titoli dei singoli blocchi (il CSS nasconde l'intestazione e
// mostra i titoli dei blocchi solo quando JS c'è).
templ textSide(page PageData, side string, label string, chooseLabel string, blocks []TextView) {
	<section class="track-side">
		<div class="side-head">
			<h2 class="side-label">{ label }</h2>
			if len(blocks) > 1 {
				<select class="lang-select" data-lang-select={ side } aria-label={ chooseLabel }>
					for _, block := range blocks {
						<option value={ block.Code } selected?={ block.Selected }>{ block.Label }</option>
					}
				</select>
			} else {
				for _, block := range blocks {
					<span class="side-lang">{ block.Label }</span>
				}
			}
		</div>
		for _, block := range blocks {
			<article class="text-block" data-text-block={ side } data-text-lang={ block.Code } data-text-selected={ block.SelectedValue() }>
				<h2 class="block-title">
					{ label }
					<span class="block-lang">{ block.Label }</span>
				</h2>
				if block.Translator != "" {
					<p class="block-translator">{ page.T("track.translator") }: { block.Translator }</p>
				}
				@stanzas(block.Stanzas)
			</article>
		}
	</section>
}

// stanzas stampa le strofe di un blocco: un verso per riga, nessuna annotazione
// per verso (decisione di prodotto: le note per verso non esistono nello
// schema).
templ stanzas(stanzas []StanzaView) {
	<div class="stanzas">
		for _, stanza := range stanzas {
			<div class="stanza">
				if stanza.Singer != "" {
					<p class="stanza-singer">{ stanza.Singer }</p>
				}
				<p class="stanza-lines">
					for _, line := range stanza.Lines {
						<span class="verse">{ line }</span>
					}
				</p>
			</div>
		}
	</div>
}
