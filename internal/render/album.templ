package render

// Album è la pagina di un album: copertina e anagrafica affiancate (band, anno,
// numero di tracce, lingue tradotte), la tracklist completa e numerata, la
// corsia degli altri album della band. La tracklist è il disco intero: i brani
// senza testo restano in elenco, senza link e non cliccabili, con il motivo
// (in arrivo, strumentale, solo originale).
templ Album(v AlbumView) {
	@Layout(v.Page) {
		@breadcrumb(v.Page.T("a11y.breadcrumb"), v.Crumbs)
		<h1 class="page-title">{ v.Title }</h1>
		if v.ShowCover {
			<div class="album-hero row">
				<figure class="album-cover col-12 col-md-4">
					<img src={ v.CoverURL } alt={ v.CoverAlt } width="600" height="600" loading="lazy"/>
				</figure>
				<div class="col-12 col-md-8">
					@albumFacts(v)
				</div>
			</div>
		} else {
			<div class="album-hero">
				@albumFacts(v)
			</div>
		}
		<section class="page-section">
			<h2 class="section-title">{ v.Page.T("album.tracks") }</h2>
			<ol class="track-items">
				for _, row := range v.Tracklist {
					<li class="track-item">
						if row.Linked {
							<a class="track-item-title" href={ row.URL }>{ row.Title }</a>
						} else {
							<span class="track-item-title">{ row.Title }</span>
							if row.ReasonKey != "" {
								<span class="track-flag">{ v.Page.T(row.ReasonKey) }</span>
							}
						}
						if row.LangsText != "" {
							<span class="track-item-langs">{ row.LangsText }</span>
						}
					</li>
				}
			</ol>
		</section>
		if len(v.OtherAlbums.Cards) > 0 {
			@railBlock(v.OtherAlbums)
		}
	}
}

// albumFacts è l'anagrafica dell'album: band (link), anno, numero di tracce e
// lingue in cui è tradotto. Sta a destra della copertina, o a tutta larghezza
// quando la copertina non c'è.
templ albumFacts(v AlbumView) {
	<dl class="album-facts">
		<dt>{ v.Page.T("album.band") }</dt>
		<dd><a href={ v.BandURL }>{ v.BandName }</a></dd>
		if v.YearText != "" {
			<dt>{ v.Page.T("album.year") }</dt>
			<dd>{ v.YearText }</dd>
		}
		<dt>{ v.Page.T("album.tracks") }</dt>
		<dd>{ v.TracksText }</dd>
		if v.LangsText != "" {
			<dt>{ v.Page.T("album.langs") }</dt>
			<dd>{ v.LangsText }</dd>
		}
	</dl>
}
