package render

import "github.com/a-h/templ"

// Footer contiene disclaimer, licenza, contatti e collegamenti di servizio.
templ Footer(d PageData) {
	<footer class="site-footer">
		<div class="container">
			<p class="footer-line">{ d.T("footer.disclaimer") }</p>
			<ul class="footer-links">
				<li><a href={ templ.URL(d.Path("contatti")) }>{ d.T("footer.contact") }</a></li>
				<li><a href={ templ.URL(d.Path("legali")) }>{ d.T("footer.legal") }</a></li>
				<li><a href={ templ.URL(d.Path("rss.xml")) }>{ d.T("footer.rss") }</a></li>
			</ul>
			<p class="footer-line">{ d.T("footer.license") }</p>
		</div>
	</footer>
}
