package render

// Footer contiene disclaimer, licenza, link al feed RSS, contatori pubblici e
// attribuzione delle immagini.
//
// Il link al feed c'è perché il file esiste (generato dal build in
// <lang>/rss.xml, D61). I link a CONTATTI e NOTE LEGALI restano fuori finché
// quelle pagine non esistono (FASE 6): un link che porta a un 404 è peggio di
// un link assente. Quando le pagine esisteranno, tornano qui.
//
// Fuori dal footer non si vede da dove vengono le immagini: questa riga è
// l'attribuzione (D84), con i link ai due archivi.
templ Footer(d PageData) {
	<footer class="site-footer">
		<div class="container">
			<p class="footer-line">{ d.T("footer.disclaimer") }</p>
			<p class="footer-line">{ d.T("footer.license") }</p>
			<ul class="footer-links">
				<li>
					<a href={ d.FeedURL() }>{ d.T("footer.rss") }</a>
				</li>
			</ul>
			<p class="footer-line footer-stats">{ d.Stats.Line(d.Bundle, d.Lang) }</p>
			<p class="footer-line">
				{ d.T("footer.credits_covers") }
				<a href="https://coverartarchive.org/">Cover Art Archive</a>
				· { d.T("footer.credits_bands") }
				<a href="https://fanart.tv/">fanart.tv</a>
			</p>
		</div>
	</footer>
}