package render

// Header è l'intestazione sticky: brand, navigazione, tema, dimensione testo.
templ Header(d PageData) {
	<header class="site-header">
		<nav class="container site-nav" aria-label={ d.T("nav.label") }>
			<a class="site-brand" href={ d.URL("") }>Lyrica</a>
			<div class="site-nav-actions">
				<a class="nav-link" href={ d.URL("") }>{ d.T("nav.home") }</a>
				<a class="nav-link" href={ d.URL("bands") }>{ d.T("nav.bands") }</a>
				<button type="button" class="btn btn-sm btn-outline-secondary" data-theme-toggle="1">
					{ d.T("nav.theme") }
				</button>
				<button type="button" class="btn btn-sm btn-outline-secondary" data-text-size="smaller" aria-label={ d.T("a11y.text_smaller") }>
					<span aria-hidden="true">A-</span>
				</button>
				<button type="button" class="btn btn-sm btn-outline-secondary" data-text-size="bigger" aria-label={ d.T("a11y.text_bigger") }>
					<span aria-hidden="true">A+</span>
				</button>
			</div>
		</nav>
	</header>
}
