package render

// NotFound è la pagina 404: messaggio breve e il campo di ricerca (D110), così
// da una pagina sbagliata si arriva a un brano giusto senza tornare alla home.
templ NotFound(d PageData) {
	@Layout(d) {
		<section class="error-page">
			<h1>{ d.T("error.not_found_title") }</h1>
			<p>{ d.T("error.not_found_body") }</p>
			@SearchBox(d)
			<p><a href={ d.URL("") }>{ d.T("error.back_home") }</a></p>
		</section>
	}
}
