package render

// Bands è la pagina delle band: la corsia delle ultime arrivate in cima (come
// in home) e sotto l'elenco completo, diviso per iniziale.
templ Bands(v BandsView) {
	@Layout(v.Page) {
		<h1 class="page-title">{ v.Page.T("nav.bands") }</h1>
		if len(v.Groups) == 0 {
			<section class="empty-state">
				<p>{ v.Page.T("bands.empty") }</p>
			</section>
		} else {
			if len(v.Latest.Cards) > 0 {
				@railBlock(v.Latest)
			}
			@bandIndex(v)
		}
	}
}

// bandIndex è l'elenco alfabetico: la barra delle iniziali e, sotto, un gruppo
// per lettera.
//
// Tutti i gruppi stanno nel DOM; il filtro per lettera è lato client
// (assets/js/lyrica.js) e usa l'attributo hidden, come il selettore di lingua
// della pagina brano. Senza JS i gruppi restano tutti visibili: il filtro è un
// di più, non un requisito.
//
// Gli attributi data-* hanno SEMPRE un valore (anche "1"): templ non riconosce
// gli attributi senza valore come parte del tag di apertura, e un elemento così
// scritto resta senza tag di chiusura in fase di parsing.
templ bandIndex(v BandsView) {
	<section class="band-index" data-band-index="1">
		<nav class="band-letters" aria-label={ v.Page.T("bands.letters_label") }>
			<button type="button" class="band-letter is-active" data-band-letter="*" aria-pressed="true">
				{ v.Page.T("bands.all") }
			</button>
			for _, letter := range v.Letters {
				<button type="button" class="band-letter" data-band-letter={ letter } aria-pressed="false">
					{ letter }
				</button>
			}
		</nav>
		for _, group := range v.Groups {
			<div class="band-group" data-band-group={ group.Letter }>
				<h2 class="band-group-letter">{ group.Letter }</h2>
				@bandGrid(group.Cards)
			</div>
		}
	</section>
}

// bandGrid è la griglia di card di una lettera: stesso formato delle card delle
// corsie (immagine 1:1 o segnaposto, nome, riga di informazioni).
templ bandGrid(cards []BandCard) {
	<ul class="band-grid">
		for _, card := range cards {
			<li class="band-card">
				<a class="band-card-link" href={ card.URL }>
					if card.HasImage {
						<img class="band-card-image" src={ card.ImageURL } alt="" width="600" height="600" loading="lazy" decoding="async"/>
					} else {
						<span class="band-card-placeholder" aria-hidden="true">{ card.Initial }</span>
					}
					<span class="band-card-name">{ card.Name }</span>
					if card.MetaText != "" {
						<span class="band-card-meta">{ card.MetaText }</span>
					}
				</a>
			</li>
		}
	</ul>
}
