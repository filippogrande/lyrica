package render

// Home è la pagina iniziale: una sequenza di corsie orizzontali (in evidenza,
// ultimi brani, ultime band). Una corsia vuota non esiste nel DOM; se non c'è
// nulla da mostrare lo stato vuoto è dichiarato, non finto.
templ Home(v HomeView) {
	@Layout(v.Page) {
		<section class="home-hero">
			<h1 class="home-title">{ v.Page.T("home.title") }</h1>
			<p class="lead">{ v.Page.T("home.lead") }</p>
			@StatsLine(v.Page)
		</section>
		if v.HasContent() {
			for _, rail := range v.Rails {
				@railBlock(rail)
			}
		} else {
			<section class="empty-state">
				<p>{ v.Page.T("home.no_content") }</p>
			</section>
		}
	}
}