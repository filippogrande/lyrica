package render

import "github.com/a-h/templ"

// Layout è la struttura comune di ogni pagina: header, contenuto, footer.
templ Layout(d PageData) {
	<!DOCTYPE html>
	<html lang={ d.Lang } data-bs-theme="auto">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ d.Title }</title>
			<link rel="stylesheet" href="/assets/css/vendor/bootstrap.min.css"/>
			<link rel="stylesheet" href="/assets/css/lyrica.css"/>
			<script src="/assets/js/theme.js"></script>
		</head>
		<body>
			<a class="skip-link" href="#contenuto">{ d.T("a11y.skip_to_content") }</a>
			@Header(d)
			<main id="contenuto" class="container py-4">
				{ children... }
			</main>
			@Footer(d)
			<script src="/assets/js/lyrica.js" defer></script>
		</body>
	</html>
}

// brandLink è l'URL della home nella lingua corrente.
templ brandLink(d PageData) {
	<a class="site-brand" href={ templ.URL(d.Path("")) }>Lyrica</a>
}
