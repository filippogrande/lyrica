// SONDA TEMPORANEA: struttura della home (if annidati, componente dentro un
// elemento, else finale).
package renderprobe

templ F(items []string) {
	if len(items) > 0 {
		if len(items) > 1 {
			<section class="s">
				<h2 class="t">{ items[0] }</h2>
				@D(items)
			</section>
		}
		<section class="s">
			<h2 class="t">{ items[0] }</h2>
			@D(items)
		</section>
	} else {
		<section class="e">
			<p>{ items[0] }</p>
		</section>
	}
}
