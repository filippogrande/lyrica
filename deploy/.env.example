# Configurazione di Lyrica — template.
#
# Copia in .env accanto al docker-compose.yml (sul home-lab: nella cartella del
# compose) e riempi solo ciò che serve:
#
#     cp .env.example .env
#
# Il file .env NON si committa (è in .gitignore): qui non va mai un segreto.
# Nel compose è letto da env_file, quindi i valori non si scrivono nel compose.

# --- Attive ora ---------------------------------------------------------

# Indirizzo di ascolto dentro il container.
# Ha già un default (:8080) impostato nel compose: decommentalo solo se vuoi
# cambiare la porta interna (e ricordati di aggiornare anche la mappa in
# docker-compose.yml).
# LYRICA_ADDR=:8080

# --- Non ancora lette dall'applicazione ---------------------------------

# Restano commentate finché la funzione non esiste: una variabile che nessuno
# legge è rumore, non configurazione (GUIDELINES.md §4).

# FASE 4/5 — URL pubblico: serve a sitemap, feed RSS e link canonici.
# LYRICA_BASE_URL=https://lyrica.filippomoscatellis.com

# FASE 5 — Umami (istanza self-hosted esistente, cookieless).
# UMAMI_URL=
# UMAMI_SITE_ID=

# FASE 6 — segnalazioni e contatti notificati su bot Telegram dedicato.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
